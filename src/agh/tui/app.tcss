Screen { layout: vertical; }

#main { height: 1fr; layout: grid; grid-size: 5 2; grid-rows: 1fr 1fr; }
#main > * { width: 1fr; height: 1fr; }

#sidebar, #explorer-pane { padding: 0 1; }
#explorer-pane { border-top: solid $panel; }
#sidebar.hidden { display: none; }
#tree { height: 1fr; background: transparent; }
#explorer-title { height: 1; text-style: bold; color: $text-muted; }
#explorer { height: 1fr; background: transparent; }
#plan { height: auto; max-height: 40%; padding: 1 0 0 0; border-top: solid $panel; }

#editor { }
#editor-bar { height: 3; padding: 0 1; }
#editor-title { width: 1fr; height: 3; content-align: left middle; }
#editor-bar Button { min-width: 8; margin-left: 1; }
#editor-text { height: 1fr; border: none; }

#chat { min-width: 40; }
#transcript { height: 1fr; padding: 0 1; scrollbar-size-vertical: 1; }

.msg { height: auto; margin: 1 0 0 0; }
.user { color: $accent; text-style: bold; border: round $panel; padding: 0 1; }
.thinking { color: $text-muted; }
.tool { height: auto; }
.tool-head { height: auto; }
.tool-io { height: auto; margin-left: 2; padding: 0 1; background: $boost; }
.tool-error .tool-io { color: $error; }
.tool-io.pending { display: none; }
#transcript.compact .tool { margin: 0; }
#transcript.compact .tool-io { display: none; }
#transcript.compact .tool-error .tool-out { display: block; }
.notice { color: $text-muted; text-style: italic; }
.error { color: $error; }
.subagent { border-left: solid $secondary; padding-left: 1; }

#status { height: 1; padding: 0 1; text-wrap: nowrap; text-overflow: ellipsis; background: $panel; color: $text-muted; }
#prompt { margin: 0 1; height: auto; min-height: 3; max-height: 12; }
#bottom { height: auto; }
#suggest { height: auto; max-height: 12; margin: 0 1; border: round $panel; background: $surface; }

ApprovalScreen, ConfirmCloseScreen { align: center middle; }
#confirm { width: 60; height: auto; padding: 1 2; border: thick $warning; background: $surface; }
#approval {
    width: 80%;
    max-width: 100;
    height: auto;
    max-height: 80%;
    padding: 1 2;
    border: thick $warning;
    background: $surface;
}
#approval-args { height: auto; max-height: 20; margin: 1 0; }
#approval-buttons { height: auto; align-horizontal: right; }
#approval-buttons Button { margin-left: 1; }


Splitter { width: 1; color: $panel-lighten-2; }
Splitter:hover, Splitter.dragging { color: $accent; background: $boost; }

SetupScreen { align: center middle; }
#setup { width: 90; max-width: 95%; height: auto; max-height: 90%; padding: 1 2; border: thick $accent; background: $surface; }
#setup-hint { margin: 1 0; }
#setup-steps { height: auto; max-height: 24; }
#step-provider, #step-model { height: auto; max-height: 20; }
#step-details { height: auto; max-height: 22; }
#step-details Input { margin-bottom: 1; }
#setup-status { height: auto; margin-top: 1; }
#setup-buttons { height: auto; align-horizontal: right; margin-top: 1; }
#setup-buttons Button { margin-left: 1; }
