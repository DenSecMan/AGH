# Copy to .env. Non-empty values here override environment variables.
# Azure OpenAI / Foundry. First in auto-detection by default; change with models.providers in agh.yaml.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2025-04-01-preview
AZURE_OPENAI_DEPLOYMENT_NAME_CHAT=
AZURE_OPENAI_DEPLOYMENT_NAME_FAST=
AZURE_OPENAI_DEPLOYMENT_NAME_REASONING=

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Local servers. Keys are optional; change the URLs if yours differ.
OLLAMA_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434/v1
LLMSTUDIO_API_KEY=
LLMSTUDIO_BASE_URL=http://localhost:1234/v1
VLLM_API_KEY=
VLLM_BASE_URL=http://localhost:8000/v1

# Web search for the researcher. Set one for reliable results; with neither, it falls back to DuckDuckGo's HTML page.
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=
